    {
      "parameters": {
        "language": "JavaScript",
        "jsCode": "const news = $items(\"Crypto News\")[0].json.items.map(i => i.title).slice(0,5).join('\n');\nconst prices = $items(\"Market Data\")[0].json;\nconst tradingViewHtml = $items(\"TradingView Page\")[0].json;\nreturn [{json:{news,prices,tradingViewHtml}}];"
